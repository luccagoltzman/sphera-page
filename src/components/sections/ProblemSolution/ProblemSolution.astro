---
import InteractiveImage from '@components/ui/InteractiveImage/InteractiveImage.astro';
import { SECTION_IMAGES } from '../../../config/images';

const problems = [
  { text: 'Alto custo de manutenção e operação', icon: '⛽' },
  { text: 'Falta de conformidade e documentação', icon: '📋' },
  { text: 'Riscos em segurança e meio ambiente', icon: '⚠️' },
  { text: 'Frota desorganizada e sem padrão', icon: '📉' },
];

const solutions = [
  { text: 'Vistorias e laudos técnicos', icon: '✔' },
  { text: 'Treinamentos e capacitação', icon: '✔' },
  { text: 'Assessoria e SSMA', icon: '✔' },
  { text: 'Melhoria contínua e redução de custo', icon: '✔' },
];
---
<section class="problem-solution" id="problema-solucao">
  <div class="problem-solution__inner">
    <h2 class="section-heading" data-reveal>
      Do problema à <span class="highlight">solução</span>
    </h2>
    <p class="section-subheading" data-reveal>
      Conhecemos os desafios das frotas automotivas e oferecemos soluções especializadas.
    </p>

    <div class="problem-solution__row">
      <div class="problem-solution__visual" data-reveal>
        <InteractiveImage
          src={SECTION_IMAGES.problemaSolucao}
          alt="Inspeção e soluções para frotas"
        />
      </div>
      <div class="problem-solution__grid">
      <div class="problem-solution__block problems" data-reveal>
        <h3 class="problem-solution__title">Problemas comuns</h3>
        <ul class="problem-solution__list">
          {problems.map((p) => (
            <li class="problem-solution__item problem">
              <span class="icon" aria-hidden>{p.icon}</span>
              <span>{p.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="problem-solution__arrow" aria-hidden>→</div>

      <div class="problem-solution__block solutions" data-reveal>
        <h3 class="problem-solution__title">Nossa solução</h3>
        <ul class="problem-solution__list">
          {solutions.map((s) => (
            <li class="problem-solution__item solution">
              <span class="icon" aria-hidden>{s.icon}</span>
              <span>{s.text}</span>
            </li>
          ))}
        </ul>
      </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  .problem-solution {
    padding-block: 3rem;
    @media (min-width: 768px) {
      padding-block: 4rem;
    }
    @media (min-width: 992px) {
      padding-block: 5rem;
    }
    background-color: #0f172a;

    &__inner {
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: 1.5rem;
      @media (min-width: 992px) {
        padding-inline: 2rem;
      }
    }

    &__row {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      margin-top: 2.5rem;
      @media (min-width: 992px) {
        flex-direction: row;
        align-items: center;
        gap: 3rem;
      }
    }

    &__visual {
      flex-shrink: 0;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      @media (min-width: 992px) {
        width: 38%;
        max-width: 380px;
      }
    }

    &__grid {
      display: grid;
      gap: 2rem;
      flex: 1;
      min-width: 0;
      grid-template-columns: 1fr;
      @media (min-width: 768px) {
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 2rem;
      }
    }

    &__block {
      padding: 1.5rem;
      border-radius: 0.75rem;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        opacity 0.4s ease;
    }

    &__title {
      font-size: 1.25rem;
      margin: 0 0 1rem;
      color: #f8fafc;
    }

    &__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    &__item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      font-size: 1rem;
      transition: transform 0.2s ease;

      .icon {
        flex-shrink: 0;
      }

      &:hover {
        transform: translateX(4px);
      }
    }

    .problem {
      color: #94a3b8;
      .icon {
        opacity: 0.8;
      }
    }

    .solution {
      color: #e2e8f0;
      .icon {
        color: #10b981;
      }
    }

    &__arrow {
      font-size: 1.5rem;
      color: #0ea5e9;
      text-align: center;
      opacity: 0.7;
    }
  }

  .section-heading,
  .section-subheading {
    text-align: center;
  }

  .section-subheading {
    margin-inline: auto;
  }

  .highlight {
    color: #0ea5e9;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);

    &.reveal-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

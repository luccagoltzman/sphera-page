---
const links = [
  { label: 'Quem somos', href: '#problema-solucao' },
  { label: 'Serviços', href: '#servicos' },
  { label: 'Cases', href: '#depoimentos' },
  { label: 'Orçamento', href: '#cta' },
  { label: 'Contato', href: '#contato' },
];

const whatsapp1 = 'https://wa.me/5511972880019';
const whatsapp2 = 'https://wa.me/5511947918825';
const logoUrl = 'https://espherasolucoes.com.br/medias/img/logo_esphera.png';
---
<footer class="footer" id="contato">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="#hero" class="footer__logo">
          <img src={logoUrl} alt="Esphera - Soluções em frotas automotivas" width="140" height="44" />
        </a>
        <p class="footer__tagline">
          Soluções em frotas automotivas. Melhoria contínua e redução de custo.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Links do site">
        <span class="footer__navTitle">Links</span>
        <ul class="footer__links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__contact">
        <span class="footer__navTitle">Contato</span>
        <address class="footer__address">
          <p><a href="mailto:contato@espherasolucoes.com.br">contato@espherasolucoes.com.br</a></p>
          <p><a href={whatsapp1} target="_blank" rel="noopener noreferrer">(11) 97288-0019</a></p>
          <p><a href={whatsapp2} target="_blank" rel="noopener noreferrer">(11) 94791-8825</a></p>
        </address>
      </div>

      <div class="footer__social">
        <span class="footer__navTitle">Atendimento</span>
        <div class="footer__socialLinks">
          <a href={whatsapp1} target="_blank" rel="noopener noreferrer" class="footer__socialLink" aria-label="WhatsApp (11) 97288-0019">WhatsApp</a>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} Esphera Soluções em Frotas. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    padding-block: 3rem 1.5rem;
    background-color: #030712;
    border-top: 1px solid rgba(148, 163, 184, 0.1);

    &__inner {
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: 1.5rem;
      @media (min-width: 992px) {
        padding-inline: 2rem;
      }
    }

    &__grid {
      display: grid;
      gap: 2rem;
      margin-bottom: 2rem;
      @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;
      }
      @media (min-width: 992px) {
        grid-template-columns: 2fr 1fr 1fr 1fr;
      }
    }

    &__logo {
      display: inline-block;
      margin-bottom: 0.75rem;
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      background: #030712;

      img {
        height: 38px;
        width: auto;
        object-fit: contain;
        mix-blend-mode: multiply;
      }
    }

    &__tagline {
      font-size: 0.9375rem;
      color: #64748b;
      margin: 0;
      max-width: 28ch;
    }

    &__navTitle {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      display: block;
      margin-bottom: 0.75rem;
    }

    &__links {
      list-style: none;
      margin: 0;
      padding: 0;

      a {
        display: block;
        padding: 0.25rem 0;
        font-size: 0.9375rem;
        color: #94a3b8;
        transition: color 0.2s;

        &:hover {
          color: #0ea5e9;
        }
      }
    }

    &__address {
      font-style: normal;
      font-size: 0.9375rem;
      color: #94a3b8;

      p {
        margin: 0.25rem 0;
      }
    }

    &__socialLinks {
      display: flex;
      gap: 1rem;
    }

    &__socialLink {
      font-size: 0.9375rem;
      color: #94a3b8;
      transition: color 0.2s;

      &:hover {
        color: #0ea5e9;
      }
    }

    &__bottom {
      padding-top: 1.5rem;
      border-top: 1px solid rgba(148, 163, 184, 0.08);

      p {
        margin: 0;
        font-size: 0.875rem;
        color: #64748b;
      }
    }
  }
</style>

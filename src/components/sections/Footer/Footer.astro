---
const links = [
  { label: 'Serviços', href: '#servicos' },
  { label: 'Resultados', href: '#metricas' },
  { label: 'Depoimentos', href: '#depoimentos' },
  { label: 'Orçamento', href: '#cta' },
];

const socials = [
  { label: 'LinkedIn', href: '#', icon: 'in' },
  { label: 'Instagram', href: '#', icon: 'ig' },
  { label: 'WhatsApp', href: '#', icon: 'wa' },
];
---
<footer class="footer" id="contato">
  <div class="footer__inner">
    <div class="footer__grid">
      <div class="footer__brand">
        <strong class="footer__logo">Sphera</strong>
        <p class="footer__tagline">
          Controle total da sua frota. Rastreamento, telemetria e gestão inteligente.
        </p>
      </div>

      <nav class="footer__nav" aria-label="Links do site">
        <span class="footer__navTitle">Links</span>
        <ul class="footer__links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__contact">
        <span class="footer__navTitle">Contato</span>
        <address class="footer__address">
          <p>contato@sphera.com.br</p>
          <p>(00) 0000-0000</p>
          <p>Av. Exemplo, 1000 — Cidade / UF</p>
        </address>
      </div>

      <div class="footer__social">
        <span class="footer__navTitle">Redes</span>
        <div class="footer__socialLinks">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label} class="footer__socialLink">
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {new Date().getFullYear()} Sphera. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<style lang="scss">
  .footer {
    padding-block: 3rem 1.5rem;
    background-color: #030712;
    border-top: 1px solid rgba(148, 163, 184, 0.1);

    &__inner {
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: 1.5rem;
      @media (min-width: 992px) {
        padding-inline: 2rem;
      }
    }

    &__grid {
      display: grid;
      gap: 2rem;
      margin-bottom: 2rem;
      @media (min-width: 768px) {
        grid-template-columns: 1fr 1fr;
      }
      @media (min-width: 992px) {
        grid-template-columns: 2fr 1fr 1fr 1fr;
      }
    }

    &__logo {
      font-family: 'Outfit', system-ui, sans-serif;
      font-size: 1.5rem;
      color: #f8fafc;
      display: block;
      margin-bottom: 0.5rem;
    }

    &__tagline {
      font-size: 0.9375rem;
      color: #64748b;
      margin: 0;
      max-width: 28ch;
    }

    &__navTitle {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      display: block;
      margin-bottom: 0.75rem;
    }

    &__links {
      list-style: none;
      margin: 0;
      padding: 0;

      a {
        display: block;
        padding: 0.25rem 0;
        font-size: 0.9375rem;
        color: #94a3b8;
        transition: color 0.2s;

        &:hover {
          color: #0ea5e9;
        }
      }
    }

    &__address {
      font-style: normal;
      font-size: 0.9375rem;
      color: #94a3b8;

      p {
        margin: 0.25rem 0;
      }
    }

    &__socialLinks {
      display: flex;
      gap: 1rem;
    }

    &__socialLink {
      font-size: 0.9375rem;
      color: #94a3b8;
      transition: color 0.2s;

      &:hover {
        color: #0ea5e9;
      }
    }

    &__bottom {
      padding-top: 1.5rem;
      border-top: 1px solid rgba(148, 163, 184, 0.08);

      p {
        margin: 0;
        font-size: 0.875rem;
        color: #64748b;
      }
    }
  }
</style>

---
const navLinks = [
  { label: 'Problema & Solução', href: '#problema-solucao' },
  { label: 'Serviços', href: '#servicos' },
  { label: 'Resultados', href: '#metricas' },
  { label: 'Depoimentos', href: '#depoimentos' },
  { label: 'Orçamento', href: '#cta' },
];

const logoUrl = 'https://espherasolucoes.com.br/medias/img/logo_esphera.png';
---
<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <a href="#hero" class="site-header__logo" aria-label="Esphera - Página inicial">
      <img src={logoUrl} alt="Esphera - Soluções em frotas automotivas" width="140" height="44" />
    </a>
    <nav class="site-header__nav" aria-label="Navegação principal">
      <ul class="site-header__links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="https://wa.me/5511972880019" class="site-header__cta" target="_blank" rel="noopener noreferrer">
      Falar no WhatsApp
    </a>
  </div>
</header>

<style lang="scss">
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    padding: 0.75rem 1.5rem;
    background: rgba(3, 7, 18, 0.75);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.08);
    transition: background 0.3s ease, border-color 0.3s ease;

    &.scrolled {
      background: rgba(3, 7, 18, 0.9);
      border-bottom-color: rgba(148, 163, 184, 0.12);
    }

    &__inner {
      max-width: 1200px;
      margin-inline: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    &__logo {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      background: #030712; // fundo sólido para o multiply remover o branco da logo

      img {
        height: 36px;
        width: auto;
        object-fit: contain;
        mix-blend-mode: multiply;
      }
    }

    &__nav {
      display: none;
      @media (min-width: 992px) {
        display: block;
      }
    }

    &__links {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      gap: 0.25rem;
    }

    &__links a {
      display: block;
      padding: 0.5rem 0.75rem;
      font-size: 0.9375rem;
      font-weight: 500;
      color: #94a3b8;
      border-radius: 0.375rem;
      transition: color 0.2s ease, background 0.2s ease;

      &:hover {
        color: #f8fafc;
        background: rgba(148, 163, 184, 0.08);
      }
    }

    &__cta {
      flex-shrink: 0;
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: #0ea5e9;
      border: 1px solid rgba(14, 165, 233, 0.4);
      border-radius: 0.5rem;
      background: rgba(14, 165, 233, 0.08);
      transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;

      &:hover {
        background: rgba(14, 165, 233, 0.18);
        border-color: #0ea5e9;
        color: #38bdf8;
      }
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 20);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

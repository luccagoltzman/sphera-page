---
import ComingSoonLayout from '@layouts/ComingSoonLayout.astro';
import logoEsphera from '../../assets/img/logo_azul_esphera.png';
---
<ComingSoonLayout>
  <main class="coming-soon" id="coming-soon-main">
    <div class="coming-soon__bg" aria-hidden>
      <div class="coming-soon__gradient" />
      <div class="coming-soon__spotlight" aria-hidden />
      <div class="coming-soon__grid" />
      <div class="coming-soon__glow" />
      <div class="coming-soon__orbs" aria-hidden>
        <span class="coming-soon__orb coming-soon__orb--1" />
        <span class="coming-soon__orb coming-soon__orb--2" />
        <span class="coming-soon__orb coming-soon__orb--3" />
      </div>
    </div>

    <div class="coming-soon__content">
      <div class="coming-soon__logo-wrap">
        <img
          src={logoEsphera.src}
          alt="Esphera Soluções em Frotas"
          width={logoEsphera.width}
          height={logoEsphera.height}
          class="coming-soon__logo"
          fetchpriority="high"
        />
      </div>
      <h1 class="coming-soon__title">
        <span class="coming-soon__word">Em</span>{' '}
        <span class="coming-soon__highlight">breve</span>
      </h1>
      <p class="coming-soon__subtitle">
        Estamos preparando uma nova experiência para você.<br />
        Soluções em frotas automotivas em breve.
      </p>
      <div class="coming-soon__divider" aria-hidden />
      <p class="coming-soon__tagline">
        Melhoria contínua, redução de custo e gestão profissional da sua frota.
      </p>
    </div>

    <footer class="coming-soon__footer">
      <a
        href="https://wa.me/5511972880019"
        target="_blank"
        rel="noopener noreferrer"
        class="coming-soon__cta"
      >
        <span class="coming-soon__cta-text">Falar no WhatsApp</span>
      </a>
    </footer>
  </main>

  <script>
    (function () {
      const main = document.getElementById('coming-soon-main');
      if (!main) return;

      const onMove = (e) => {
        const x = (e.clientX / window.innerWidth) * 100;
        const y = (e.clientY / window.innerHeight) * 100;
        main.style.setProperty('--mouse-x', `${x}%`);
        main.style.setProperty('--mouse-y', `${y}%`);
        main.style.setProperty('--spot-opacity', '1');
      };

      const onLeave = () => {
        main.style.setProperty('--spot-opacity', '0');
      };

      main.addEventListener('mousemove', onMove);
      main.addEventListener('mouseleave', onLeave);
    })();
  </script>
</ComingSoonLayout>

<style lang="scss">
  .coming-soon-page {
    min-height: 100vh;
    margin: 0;
    overflow-x: hidden;
  }

  .coming-soon {
    --mouse-x: 50%;
    --mouse-y: 50%;
    --spot-opacity: 0;
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem 3rem;
    isolation: isolate;
    transition: background 0.2s ease;
  }

  .coming-soon__bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .coming-soon__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 120% 80% at 50% -30%, rgba(14, 165, 233, 0.15), transparent 50%),
      radial-gradient(ellipse 80% 60% at 80% 50%, rgba(6, 182, 212, 0.08), transparent 45%),
      radial-gradient(ellipse 60% 80% at 20% 80%, rgba(14, 165, 233, 0.06), transparent 45%),
      linear-gradient(180deg, #030712 0%, #0f172a 40%, #030712 100%);
  }

  .coming-soon__spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--mouse-x) var(--mouse-y),
      rgba(14, 165, 233, 0.12),
      transparent 40%
    );
    opacity: var(--spot-opacity);
    transition: opacity 0.4s ease;
  }

  .coming-soon__orbs {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .coming-soon__orb {
    position: absolute;
    border-radius: 50%;
    background: rgba(14, 165, 233, 0.08);
    animation: comingSoonOrb 15s ease-in-out infinite;
    pointer-events: none;

    &--1 {
      width: 300px;
      height: 300px;
      top: 10%;
      left: 10%;
      animation-delay: 0s;
    }
    &--2 {
      width: 200px;
      height: 200px;
      top: 60%;
      right: 15%;
      animation-delay: -5s;
    }
    &--3 {
      width: 180px;
      height: 180px;
      bottom: 20%;
      left: 30%;
      animation-delay: -10s;
    }
  }

  @keyframes comingSoonOrb {
    0%, 100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.6;
    }
    33% {
      transform: translate(30px, -20px) scale(1.1);
      opacity: 0.9;
    }
    66% {
      transform: translate(-20px, 25px) scale(0.95);
      opacity: 0.7;
    }
  }

  .coming-soon__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black, transparent);
  }

  .coming-soon__glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 600px;
    height: 300px;
    background: radial-gradient(ellipse 80% 100% at 50% 100%, rgba(14, 165, 233, 0.12), transparent 70%);
    pointer-events: none;
  }

  .coming-soon__content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 520px;
  }

  .coming-soon__logo-wrap {
    margin-bottom: 2.5rem;
    animation: comingSoonFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    cursor: default;
  }

  .coming-soon__logo {
    width: 100%;
    max-width: 280px;
    height: auto;
    border-radius: 60px;
    display: block;
    margin: 0 auto;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
  }

  .coming-soon__logo-wrap:hover .coming-soon__logo {
    transform: scale(1.05);
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.35))
      drop-shadow(0 0 40px rgba(14, 165, 233, 0.15));
  }

  .coming-soon__title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: #f8fafc;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    animation: comingSoonFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .coming-soon__word {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
  }

  .coming-soon__title:hover .coming-soon__word {
    transform: translateY(-2px);
    color: #e2e8f0;
  }

  .coming-soon__highlight {
    color: #0ea5e9;
    position: relative;
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      text-shadow 0.3s ease;
  }

  .coming-soon__title:hover .coming-soon__highlight {
    transform: translateY(-2px) scale(1.02);
    text-shadow: 0 0 30px rgba(14, 165, 233, 0.4);
  }

  .coming-soon__subtitle {
    font-size: 1.125rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 0 2rem;
    animation: comingSoonFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
    transition: color 0.3s ease;
  }

  .coming-soon__content:hover .coming-soon__subtitle {
    color: #cbd5e1;
  }

  .coming-soon__divider {
    width: 80px;
    height: 3px;
    margin: 0 auto 2rem;
    background: linear-gradient(90deg, transparent, #0ea5e9, transparent);
    border-radius: 2px;
    opacity: 0.8;
    transform-origin: center;
    animation: comingSoonFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .coming-soon__content:hover .coming-soon__divider {
    opacity: 1;
    transform: scaleX(1.25);
  }

  .coming-soon__tagline {
    font-size: 0.9375rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
    animation: comingSoonFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
    transition: color 0.3s ease;
  }

  .coming-soon__content:hover .coming-soon__tagline {
    color: #94a3b8;
  }

  .coming-soon__footer {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 3rem;
    animation: comingSoonFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
  }

  .coming-soon__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2rem;
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #030712;
    background: linear-gradient(135deg, #0ea5e9, #06b6d4);
    border: none;
    border-radius: 0.75rem;
    text-decoration: none;
    box-shadow: 0 4px 24px -4px rgba(14, 165, 233, 0.4);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease,
      background 0.3s ease;

    &:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 12px 40px -8px rgba(14, 165, 233, 0.55),
        0 0 0 1px rgba(255, 255, 255, 0.1) inset;
      background: linear-gradient(135deg, #38bdf8, #22d3ee);
    }

    &:active {
      transform: translateY(-1px);
    }

    &:focus-visible {
      outline: 2px solid #0ea5e9;
      outline-offset: 3px;
    }
  }

  .coming-soon__cta-text {
    position: relative;
    transition: transform 0.3s ease;
  }

  .coming-soon__cta:hover .coming-soon__cta-text {
    transform: translateX(2px);
  }

  @keyframes comingSoonFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
